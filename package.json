{
  "name": "overtree",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "doctor": "tsx scripts/doctor.ts",
    "mcp": "tsx mcp-server/stdio.ts",
    "mcp-config": "tsx scripts/print-mcp-config.ts",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON \"bun run dev\" \"wait-on tcp:3737 && OVERTREE_DEV_URL=http://localhost:3737 electron electron/main.cjs\"",
    "electron:build:server": "node scripts/build-server.mjs",
    "app:dist": "next build --webpack && bun run electron:build:server && electron-builder --mac"
  },
  "bin": {
    "overtree-mcp": "mcp-server/stdio.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "iron-session": "^8.0.4",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "electron",
    "electron-builder",
    "electron-builder-app-deps",
    "esbuild",
    "@parcel/watcher"
  ],
  "build": {
    "appId": "com.overtree.app",
    "productName": "Overtree",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      ".next/**",
      "public/**",
      "templates/**",
      "mcp-server/**",
      "package.json",
      "node_modules/**",
      "!node_modules/**/{test,tests,__tests__,docs,*.md,*.map}"
    ],
    "asar": false,
"mac": {
  "target": [
    {
    "target": "dmg",
    "arch": ["arm64", "x64"]
  },
  {
  "target": "zip",
  "arch": ["arm64", "x64"]
}
],
"category": "public.app-category.productivity",
"icon": "build/icon.icns",
"identity": null,
"hardenedRuntime": false,
"gatekeeperAssess": false
}
}
}
